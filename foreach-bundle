#!/usr/bin/env bash
#
# Runs a shell command in the folder of every bundled package, for example:
#
#   ./foreach-bundle git status
#   ./foreach-bundle 'git pull && composer update'
#
# Keeps going when the command fails in a folder, and exits with an error code
# when it failed in any of them.
#

set -euo pipefail

if [[ $# -eq 0 ]]; then
	echo "Usage: foreach-bundle <command>" >&2
	exit 1
fi

COMMAND="$*"

get_bundle_dependencies()
{
	echo "wp-cli/wp-cli-bundle"
	curl -fsS "https://raw.githubusercontent.com/wp-cli/wp-cli-bundle/main/composer.json" \
		| jq --raw-output '."require" | keys[] | select(startswith("wp-cli/"))'
}

DEPENDENCIES=$(get_bundle_dependencies)
FAILED=()

while read -r dependency; do
	repo_path="${dependency#wp-cli/}"
	if [[ ! -d "${repo_path}" ]]; then
		continue
	fi

	echo "--- ${repo_path}: ---"
	if ! ( cd "${repo_path}" && bash -c "${COMMAND}" ); then
		FAILED+=("${repo_path}")
	fi
done <<< "${DEPENDENCIES}"

if [[ ${#FAILED[@]} -gt 0 ]]; then
	echo "The command failed in: ${FAILED[*]}" >&2
	exit 1
fi
