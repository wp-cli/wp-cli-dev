<?xml version="1.0"?>
<ruleset name="WP-CLI-Dev">
	<description>Custom ruleset for the WP-CLI development environment</description>

	<!--
	#############################################################################
	COMMAND LINE ARGUMENTS
	For help understanding this file: https://github.com/PHPCSStandards/PHP_CodeSniffer/wiki/Annotated-ruleset.xml
	For help using PHPCS: https://github.com/PHPCSStandards/PHP_CodeSniffer/wiki/Usage
	#############################################################################
	-->

	<!-- What to scan. -->
	<file>./.maintenance/</file>

	<!-- Show progress. -->
	<arg value="p"/>

	<!-- Strip the filepaths down to the relevant bit. -->
	<arg name="basepath" value="./"/>

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8"/>

	<!--
	#############################################################################
	USE THE WP_CLI_CS RULESET
	#############################################################################
	-->

	<rule ref="WP_CLI_CS"/>

	<!--
	#############################################################################
	PROJECT SPECIFIC CONFIGURATION FOR SNIFFS
	#############################################################################
	-->

	<!-- For help understanding the `testVersion` configuration setting:
		 https://github.com/PHPCompatibility/PHPCompatibility#sniffing-your-code-for-compatibility-with-specific-php-versions -->
	<config name="testVersion" value="7.2-"/>

	<!--
	#############################################################################
	SELECTIVE EXCLUSIONS
	#############################################################################
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/.maintenance/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>*/.maintenance/*</exclude-pattern>
	</rule>

	<!-- peek.php is a self-contained, single-file tool that is meant to be
		 copied around as-is, so it deliberately mixes functions and classes. -->
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<exclude-pattern>*/.maintenance/peek.php</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/.maintenance/peek.php</exclude-pattern>
	</rule>

	<!-- peek.php probes optional platform features (unix domain sockets,
		 pcntl, stty, proc_open) and treats every failure as "unsupported, fall
		 back to a plain passthrough". Silencing is the error handling there. -->
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<exclude-pattern>*/.maintenance/peek.php</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.AssignmentInCondition">
		<exclude-pattern>*/.maintenance/peek.php</exclude-pattern>
	</rule>

</ruleset>
